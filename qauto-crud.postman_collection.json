              "if (!pm.collectionVariables.get('testEmail')) {",
              "    console.warn('testEmail is empty - схоже, Signup не виконувався в цьому прогоні. Cleanup може впасти з 401.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test('Response status field is ok', function () {",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "});",
              "",
              "pm.test('Cleanup remaining collection variables', function () {",
              "    pm.collectionVariables.unset('testEmail');",
              "    pm.collectionVariables.unset('testPassword');",
              "    pm.collectionVariables.unset('testName');",
              "    pm.collectionVariables.unset('testLastName');",
              "    pm.collectionVariables.unset('testUserId');",
              "});"
            ]
          }
        }
